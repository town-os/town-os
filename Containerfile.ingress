# Pinned to the BUILD platform and cross-compiled: this binary is CGO_ENABLED=0
# (deliberately — see CLAUDE.md on why the ingress never imports src/systemd),
# so GOARCH alone produces the target binary with no toolchain to install and
# nothing emulated.
FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.25-bookworm AS builder
ARG TARGETARCH
COPY go.mod go.sum /src/
WORKDIR /src
RUN go mod download
COPY . /src
RUN GOOS=linux GOARCH="${TARGETARCH:-$(go env GOARCH)}" CGO_ENABLED=0 go build -o /town-os-ingress ./src/ingress/cmd/town-os-ingress

# NOT pinned to the build platform: the caddy binary is copied into the runtime
# image and has to be the TARGET arch.
FROM docker.io/library/caddy:2-alpine AS caddy

FROM docker.io/library/alpine:latest
RUN apk add --no-cache ca-certificates
COPY --from=caddy /usr/bin/caddy /usr/bin/caddy
COPY --from=builder /town-os-ingress /town-os-ingress
# ENTRYPOINT (not CMD): the systemd unit launches the container with flag-only
# args (--socket … --port …) appended, matching how the manager builds the
# command. With CMD those args would replace the binary and podman would try to
# exec "--socket" itself; ENTRYPOINT makes them flags to /town-os-ingress.
ENTRYPOINT ["/town-os-ingress"]
