# vim: bash

# Username for authenticating with package git repositories (e.g. Gitea or
# GitHub username). Used when cloning private repos and as the default
# credential for newly added repositories.
TOWN_OS_REPO_USERNAME=

# Password or HTTP API key for authenticating with package git repositories.
# For GitHub this is a personal access token; for Gitea it is an API key.
TOWN_OS_REPO_PASSWORD=

# Address for the systemcontroller API server to listen on.
# Format is "[host]:port". Overridden by the -listen CLI flag.
# Default: :5309
#TOWN_OS_LISTEN=:5309

# Container network mode used by the systemcontroller when running package
# containers. Set to "host" to use --net host; leave empty (the default) to
# use bridge networking with -p port mappings. Overridden by the -network-mode
# CLI flag.
#TOWN_OS_NETWORK_MODE=

# When set, the systemcontroller loads only test package repos (no default
# repos). Used by integration tests to avoid shadowing test packages.
#TOWN_OS_TEST=1

# Docker Hub credentials for authenticated image pulls (avoids rate limits).
#DOCKER_USERNAME=
#DOCKER_PASSWORD=
