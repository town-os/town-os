# Town OS object storage (gfeh)
#
# gfeh's own repository publishes to crates.io and ships no container image --
# its Makefile names quay.io/town/gfeh but the build rules were never written --
# so the image is built here, from the published crate.
#
# Build (rootful podman via make/build.sh, with --network=host; see CLAUDE.md):
#   sudo podman build -f Containerfile.gfeh -t quay.io/town/gfeh:latest .
#
# The build always takes the current crates.io release of gfehd. There is no
# version knob, deliberately.
#
# There used to be one (GFEH_VERSION, with a GFEH_LATEST escape hatch), and it
# was worse than nothing: the Makefile passed GFEH_VERSION on every build as a
# --build-arg, which WINS over an ARG default, so the number that shipped was
# the Makefile's and the number documented here was decoration. The two drifted
# — this file said 0.1.2 and explained at length why anything older cannot run
# under Town OS, while the Makefile quietly built 0.1.1 — and nothing caught it,
# because a wrong-but-real gfehd builds, pushes, and installs perfectly. The
# unit suite stands in a fake daemon; the integration and UI suites run the real
# one, but an old daemon still starts. It only shows up as object storage that
# never starts on a real box.
#
# For the record, since it is the reason the pin existed: 0.1.1 cannot parse a
# partition config carrying any SMB user (every gfehd config struct is
# #[serde(deny_unknown_fields)] and its SmbConfig has no users field), and it
# authenticates to Town OS the instant it starts, which during boot is the :5309
# stub answering 403 to everything but the ping. Taking the current release
# clears both by construction and cannot silently regress to a version that
# does not.

# Pinned to the BUILD platform: rustc runs natively and cross-compiles, because
# emulating a full dependency-tree Rust build is the slowest thing in this repo
# by a wide margin.
FROM --platform=$BUILDPLATFORM docker.io/library/rust:1-bookworm AS builder
ARG TARGETARCH
ARG BUILDARCH
# Cross needs three things: the rustup target, a linker for it, and (for any
# dependency carrying a build script that links C) the target arch's dev
# libraries via dpkg multiarch. PKG_CONFIG_ALLOW_CROSS lets pkg-config answer
# at all when host and target differ; PKG_CONFIG_LIBDIR is what points it at
# the target's .pc files rather than the host's.
RUN set -eux; \
    if [ "${TARGETARCH}" != "${BUILDARCH}" ]; then \
      case "${TARGETARCH}" in \
        arm64) rust_target=aarch64-unknown-linux-gnu; cross_gcc=gcc-aarch64-linux-gnu ;; \
        amd64) rust_target=x86_64-unknown-linux-gnu;  cross_gcc=gcc-x86-64-linux-gnu ;; \
        *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
      esac; \
      dpkg --add-architecture "${TARGETARCH}"; \
      apt-get update; \
      apt-get install -y --no-install-recommends \
        "${cross_gcc}" pkg-config "libssl-dev:${TARGETARCH}"; \
      apt-get clean; rm -rf /var/lib/apt/lists/*; \
      rustup target add "${rust_target}"; \
      echo "${rust_target}" > /rust-target; \
    fi

# No --version and no --locked: the point is the current release, resolved
# against current dependencies.
#
# The layer this produces is the one podman would happily serve from cache
# forever, which for a build whose whole contract is "whatever crates.io holds
# today" would quietly freeze the crate at whatever was current the first time.
# Both builds defeat that: release-gfeh passes --no-cache, and gfeh-local passes
# GFEH_CACHE_DATE so the fixture rebuilds once a day instead of recompiling the
# dependency tree on every test-integration and dev run.
#
# GFEH_CACHE_DATE is a cache key, not a version knob — it never reaches cargo.
# It must be referenced in the RUN, not merely declared: an unused ARG does not
# invalidate the layer.
ARG GFEH_CACHE_DATE

# cargo install writes to <root>/bin regardless of --target, so the COPY below
# is the same path either way.
RUN set -eux; \
    : "cache key ${GFEH_CACHE_DATE}"; \
    if [ -f /rust-target ]; then \
      rust_target="$(cat /rust-target)"; \
      linker_var="CARGO_TARGET_$(echo "${rust_target}" | tr 'a-z-' 'A-Z_')_LINKER"; \
      case "${rust_target}" in \
        aarch64-*) export "${linker_var}=aarch64-linux-gnu-gcc"; triple=aarch64-linux-gnu ;; \
        x86_64-*)  export "${linker_var}=x86_64-linux-gnu-gcc";  triple=x86_64-linux-gnu ;; \
      esac; \
      export PKG_CONFIG_ALLOW_CROSS=1; \
      export PKG_CONFIG_LIBDIR="/usr/lib/${triple}/pkgconfig:/usr/share/pkgconfig"; \
      set -- --target "${rust_target}"; \
    else \
      set --; \
    fi; \
    cargo install gfehd --root /out "$@"

FROM docker.io/library/debian:bookworm-slim
# ca-certificates is mandatory for any runtime image making outbound HTTPS
# calls (CLAUDE.md): without it Go's and Rust's TLS stacks fail every request
# with an unknown-authority error, and in a background poller that failure is
# invisible at default log level.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && apt-get clean && rm -rf /var/lib/apt/lists/*

# The uid gfeh runs as. Pinned to match gfeh.UID/gfeh.GID in src/gfeh, which is
# what a partition's subvolume is chowned to -- a bind mount passes host
# ownership straight through, so the two must agree or the daemon starts and
# fails on its first write. Changing one means changing both AND chowning every
# existing partition.
RUN groupadd -g 2000 gfeh \
 && useradd -u 2000 -g 2000 -M -s /usr/sbin/nologin gfeh

COPY --from=builder /out/bin/gfehd /usr/bin/gfehd

USER 2000:2000

# CMD rather than ENTRYPOINT, per CLAUDE.md, and the config path is baked in
# rather than passed by the unit. That combination is what makes CMD workable
# here: with a bare CMD ["/usr/bin/gfehd"], `podman run <image> --config x`
# REPLACES the command and podman tries to exec "--config" -- the trap
# Containerfile.ingress documents at its ENTRYPOINT line. Every partition
# mounts its own config at the same in-container path, so nothing needs to vary
# per unit.
CMD ["/usr/bin/gfehd", "--config", "/etc/gfeh/gfehd.yaml"]
