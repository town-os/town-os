ARG TOWN_OS_IMAGE=town-os
FROM docker.io/library/debian:bookworm AS runtime-deps
RUN apt-get update && apt-get install -y \
    btrfs-progs libsystemd0 podman runc socat \
    systemd systemd-sysv dbus curl git iptables \
    pigz lbzip2 p7zip-full xz-utils unzip less \
    ca-certificates \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
# Keep podman's per-network subnet allocation off 10.64.0.0/10, which town-os
# reserves for WireGuard overlays (src/wireguard/ipam.go). 172.16.0.0/12 avoids
# the overlap that otherwise exhausts the pool under load.
RUN printf '[engine]\nruntime = "runc"\n\n[network]\ndefault_subnet_pools = [{"base" = "172.16.0.0/12", "size" = 24}]\n' > /etc/containers/containers.conf

FROM ${TOWN_OS_IMAGE} AS town-os

FROM runtime-deps
COPY --from=town-os /systemcontroller /systemcontroller
COPY --from=town-os /town-os-networkcontroller /town-os-networkcontroller
COPY --from=town-os /town-os.tag /town-os.tag
COPY --from=town-os /ui /ui
COPY integration/testdata/town-os-systemcontroller.service /etc/systemd/system/
COPY integration/testdata/town-os-system--rolodex.service /etc/systemd/system/
# The rolodex image is per-arch (rc.latest-x86_64 / rc.latest-aarch64); the build
# injects the host's arch tag so the baked unit never references rc.latest.
ARG ROLODEX_IMAGE
RUN test -n "${ROLODEX_IMAGE}" && \
    sed -i "s|@ROLODEX_IMAGE@|${ROLODEX_IMAGE}|" /etc/systemd/system/town-os-system--rolodex.service
RUN printf 'nameserver 127.0.0.1\n' > /etc/resolv.conf
RUN systemctl enable town-os-systemcontroller.service town-os-system--rolodex.service podman.socket
EXPOSE 5309
CMD ["/lib/systemd/systemd"]
