FROM oven/bun:latest

# Fixed cache path so the make pipeline can mount .cache/bun into the build
# (same pattern as the go-mod/go-build volumes). This image is built with
# --no-cache, so without the mounted bun cache every test-full run would
# re-download all packages from the network.
ENV BUN_INSTALL_CACHE_DIR=/bun-cache

COPY ui/package.json ui/bun.lock /ui/
WORKDIR /ui

RUN bun install --frozen-lockfile

COPY ui/ /ui/
