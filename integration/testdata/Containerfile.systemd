ARG TOWN_OS_IMAGE=town-os
FROM docker.io/library/golang:1.25-bookworm AS go-deps
RUN apt-get update && apt-get install -y libsystemd-dev

FROM go-deps AS builder
COPY go.mod go.sum /src/
WORKDIR /src
RUN go mod download
COPY . /src
# TOWN_OS_GO_TAGS is forwarded by the make pipeline. Empty by default;
# PROTON_ENABLED=1 sets it to "proton" so proton-tagged tests compile in.
ARG TOWN_OS_GO_TAGS=
RUN CGO_ENABLED=1 go test -tags "${TOWN_OS_GO_TAGS}" -c -o /integration-test ./integration/...

FROM docker.io/library/debian:bookworm AS runtime-deps
RUN apt-get update && apt-get install -y \
    btrfs-progs libsystemd0 podman runc socat \
    systemd systemd-sysv dbus curl git iptables \
    pigz lbzip2 p7zip-full xz-utils unzip less \
    ca-certificates \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
# Keep podman's per-network subnet allocation off 10.64.0.0/10, which town-os
# reserves for WireGuard overlays (src/wireguard/ipam.go). Overlapping default
# pools get their in-range /24s skipped and exhaust under the parallel real-
# container test load ("could not find free subnet from subnet pools"), which
# leaves package containers looping on "network not found". 172.16.0.0/12 avoids it.
RUN printf '[engine]\nruntime = "runc"\n\n[network]\ndefault_subnet_pools = [{"base" = "172.16.0.0/12", "size" = 24}]\n' > /etc/containers/containers.conf

FROM ${TOWN_OS_IMAGE} AS town-os

FROM runtime-deps
COPY --from=town-os /systemcontroller /systemcontroller
COPY --from=town-os /town-os-networkcontroller /town-os-networkcontroller
COPY --from=town-os /ui /ui
COPY --from=builder /integration-test /integration-test
COPY integration/testdata/town-os-systemcontroller.service /etc/systemd/system/
COPY integration/testdata/town-os-package--repo-test-1.0.service /etc/systemd/system/
RUN printf 'nameserver 127.0.0.2\n' > /etc/resolv.conf \
    && mkdir -p /etc/systemd/resolved.conf.d \
    && printf '[Resolve]\nDNS=127.0.0.2\n' > /etc/systemd/resolved.conf.d/rolodex.conf
RUN systemctl enable town-os-systemcontroller.service town-os-package--repo-test-1.0.service podman.socket
RUN mkdir -p /test /etc/containers/registries.conf.d \
    && mkdir -p /data/repos/repo/packages/test /data/repos/installed/repo/test \
    && printf 'image: test:1.0\n' > /data/repos/repo/packages/test/1.0.yaml \
    && ln /data/repos/repo/packages/test/1.0.yaml /data/repos/installed/repo/test/1.0.yaml
EXPOSE 5309 5310
CMD ["/lib/systemd/systemd"]
