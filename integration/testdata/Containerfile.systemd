FROM golang:1.25-bookworm AS go-deps
RUN apt-get update && apt-get install -y libsystemd-dev

FROM go-deps AS builder
COPY go.mod go.sum /src/
WORKDIR /src
RUN go mod download
COPY . /src
RUN CGO_ENABLED=1 go test -c -tags podman -o /integration-test ./integration/...

FROM debian:bookworm-slim AS runtime-deps
RUN apt-get update && apt-get install -y \
    btrfs-progs libsystemd0 podman \
    systemd systemd-sysv dbus curl git \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

FROM runtime-deps
COPY --from=town-os /systemcontroller /systemcontroller
COPY --from=town-os /town-os-upnp /town-os-upnp
COPY --from=town-os /ui /ui
COPY --from=builder /integration-test /integration-test
COPY integration/testdata/town-os-systemcontroller.service /etc/systemd/system/
COPY integration/testdata/town-os-test.service /etc/systemd/system/
RUN systemctl enable town-os-systemcontroller.service town-os-test.service
RUN mkdir -p /test /data/btrfs /data/repos /data/db
EXPOSE 5309
CMD ["/lib/systemd/systemd"]
