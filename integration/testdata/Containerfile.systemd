FROM golang:1.25-bookworm AS go-deps
RUN apt-get update && apt-get install -y libsystemd-dev

FROM go-deps AS builder
COPY go.mod go.sum /src/
WORKDIR /src
RUN go mod download
COPY . /src
RUN CGO_ENABLED=1 go test -c -o /integration-test ./integration/...

FROM debian:bookworm-slim AS runtime-deps
RUN apt-get update && apt-get install -y \
    btrfs-progs libsystemd0 podman runc socat \
    systemd systemd-sysv dbus curl git iptables \
    pigz lbzip2 p7zip-full xz-utils unzip \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
RUN printf '[engine]\nruntime = "runc"\n' > /etc/containers/containers.conf

FROM runtime-deps
COPY --from=town-os /systemcontroller /systemcontroller
COPY --from=town-os /town-os-networkcontroller /town-os-networkcontroller
COPY --from=town-os /ui /ui
COPY --from=builder /integration-test /integration-test
COPY integration/testdata/town-os-systemcontroller.service /etc/systemd/system/
COPY integration/testdata/town-os-package--repo-test-1.0.service /etc/systemd/system/
RUN systemctl enable town-os-systemcontroller.service town-os-package--repo-test-1.0.service
RUN mkdir -p /test /data/btrfs /data/repos /data/db /var/run/town-os
EXPOSE 5309 5310
CMD ["/lib/systemd/systemd"]
