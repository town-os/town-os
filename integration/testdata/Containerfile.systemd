ARG TOWN_OS_IMAGE=town-os
FROM docker.io/library/golang:1.25-bookworm AS go-deps
RUN apt-get update && apt-get install -y libsystemd-dev

FROM go-deps AS builder
COPY go.mod go.sum /src/
WORKDIR /src
RUN go mod download
COPY . /src
# TOWN_OS_GO_TAGS is forwarded by the make pipeline. Empty by default;
# PROTON_ENABLED=1 sets it to "proton" so proton-tagged tests compile in.
ARG TOWN_OS_GO_TAGS=
RUN CGO_ENABLED=1 go test -tags "${TOWN_OS_GO_TAGS}" -c -o /integration-test ./integration/...

FROM docker.io/library/debian:bookworm AS runtime-deps
# wireguard-tools + iproute2: the integration container runs the generated
# town-os-network--<name>.service units under its own systemd, so
# `ExecStart=/usr/bin/wg-quick up <conf>` (src/systemd/unit.go) execs in this
# rootfs — the same reason Containerfile.dev needs them. Without the binary the
# only symptom is a unit that is loaded but not active, which is exactly what
# TestNetworkReconcileRealSystemd already tolerates for a disabled network, so
# the gap is invisible unless the binary's presence is asserted directly.
RUN apt-get update && apt-get install -y \
    btrfs-progs libsystemd0 podman runc socat \
    systemd systemd-sysv dbus curl git iptables \
    pigz lbzip2 p7zip-full xz-utils unzip less \
    ca-certificates \
    wireguard-tools iproute2 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
# Keep podman's per-network subnet allocation off 10.64.0.0/10, which town-os
# reserves for WireGuard overlays (src/wireguard/ipam.go). Overlapping default
# pools get their in-range /24s skipped and exhaust under the parallel real-
# container test load ("could not find free subnet from subnet pools"), which
# leaves package containers looping on "network not found". 172.16.0.0/12 avoids it.
RUN printf '[engine]\nruntime = "runc"\n\n[network]\ndefault_subnet_pools = [{"base" = "172.16.0.0/12", "size" = 24}]\n' > /etc/containers/containers.conf

FROM ${TOWN_OS_IMAGE} AS town-os

# The same caddy the ingress image ships (Containerfile.ingress), for the same
# reason it is pinned there: a test that validates a rendered Caddyfile against a
# *different* caddy than the one serving it is a test that can pass while the box
# refuses to boot.
#
# Without it `findCaddy` (src/ingress/integration_test.go) finds nothing and four
# tests skip — the two that drive a real caddy over real sockets, the one that
# proves a bad hostname cannot take the whole config down, and the one that
# proves path-scoped `handle` blocks are config caddy accepts. All four skipped
# in every harness run, which reads identically to passing in the summary line.
FROM docker.io/library/caddy:2-alpine AS caddy

FROM runtime-deps
COPY --from=town-os /systemcontroller /systemcontroller
COPY --from=town-os /town-os-networkcontroller /town-os-networkcontroller
COPY --from=town-os /ui /ui
COPY --from=builder /integration-test /integration-test
# /usr/bin/caddy exactly, because that is caddysup.DefaultCaddyBinary and so the
# second place findCaddy looks after $PATH.
COPY --from=caddy /usr/bin/caddy /usr/bin/caddy
# Proves the binary can exec in this rootfs at BUILD time. It comes from an
# alpine image into a debian one, which is only safe because caddy is built
# CGO-free and therefore static; if that ever stops being true the failure must
# land here, naming itself, rather than turning four skipped tests into four
# failing ones that look like the ingress broke.
RUN /usr/bin/caddy version
COPY integration/testdata/town-os-systemcontroller.service /etc/systemd/system/
COPY integration/testdata/town-os-package--repo-test-1.0.service /etc/systemd/system/
RUN printf 'nameserver 127.0.0.2\n' > /etc/resolv.conf \
    && mkdir -p /etc/systemd/resolved.conf.d \
    && printf '[Resolve]\nDNS=127.0.0.2\n' > /etc/systemd/resolved.conf.d/rolodex.conf
RUN systemctl enable town-os-systemcontroller.service town-os-package--repo-test-1.0.service podman.socket
# binfmt_misc is global kernel state and this container is --privileged in the
# host's user namespace, so nothing separates its /proc/sys/fs/binfmt_misc from
# the machine's. Both of Debian's binfmt paths therefore write to the HOST:
# systemd-binfmt (whose ExecStop is `--unregister`, which clears EVERY handler
# rather than only the ones it registered) and binfmt-support's update-binfmts,
# which mounts binfmt_misc itself if it is not already mounted — which is why
# masking the mount units alone is not enough.
#
# This is not a hypothetical. An x86_64 Manjaro host running this suite was
# found with all 35 of its qemu-* handlers gone and a single entry left in
# their place:
#
#   /proc/sys/fs/binfmt_misc/python3.11 -> interpreter /usr/bin/python3.11
#
# That host runs Python 3.14 and has no /usr/bin/python3.11, no update-binfmts,
# and no /var/lib/binfmts — the entry is Debian's, registered from in here,
# pointing at an interpreter that exists only in this rootfs. The cost is that
# `TARGET=aarch64 make push-rc` stops working after any test run, because the
# qemu-aarch64 handler a cross build needs is collateral damage.
#
# Nothing in the suite runs a foreign-arch binary or a .pyc through binfmt, so
# there is nothing to lose by masking all of it.
#
# This is one direction of a general hazard: a privileged container is not
# isolated from host kernel state that is not namespaced. Anything else this
# image gains that reaches out that way belongs on this list.
RUN systemctl mask systemd-binfmt.service binfmt-support.service \
    proc-sys-fs-binfmt_misc.automount proc-sys-fs-binfmt_misc.mount
RUN mkdir -p /test /etc/containers/registries.conf.d \
    && mkdir -p /data/repos/repo/packages/test /data/repos/installed/repo/test \
    && printf 'image: test:1.0\n' > /data/repos/repo/packages/test/1.0.yaml \
    && ln /data/repos/repo/packages/test/1.0.yaml /data/repos/installed/repo/test/1.0.yaml
EXPOSE 5309 5310
CMD ["/lib/systemd/systemd"]
