FROM golang:1.25-bookworm AS builder

RUN apt-get update && apt-get install -y libsystemd-dev

COPY go.mod go.sum /src/
WORKDIR /src

RUN go mod download

COPY . /src

RUN CGO_ENABLED=1 go test -c -tags podman -o /podman-test ./integration/...

FROM debian:bookworm

RUN apt-get update && apt-get install -y \
    systemd systemd-sysv dbus \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --from=builder /podman-test /podman-test
COPY integration/testdata/town-os-test.service /etc/systemd/system/
RUN systemctl enable town-os-test.service

CMD ["/lib/systemd/systemd"]
