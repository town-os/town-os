[Unit]
Description=Town OS System Controller
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=on-failure
RestartSec=2
PassEnvironment=LOG_LEVEL DEBUG TOWN_OS_REPO_USERNAME TOWN_OS_REPO_PASSWORD TOWN_OS_LISTEN TOWN_OS_TEST TOWN_OS_TEST_REPO_CORE_URL TOWN_OS_TEST_REPO_EXTRAS_URL ROLODEX_IMAGE UI_IMAGE NC_IMAGE INGRESS_IMAGE GFEH_IMAGE TOWN_OS_DNS_PORT TOWN_OS_NODE_EXPORTER_PORT TOWN_OS_PROMETHEUS_PORT TOWN_OS_MONITORING_PORT INGRESS_HTTPS_PORT INGRESS_HTTP_PORT TOWN_OS_WG_SALT
ExecStart=/systemcontroller -db /data/db/dev.db -btrfs /town-os -repo-dir /data/repos

[Install]
WantedBy=multi-user.target
